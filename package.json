{
  "repository": {
    "type": "git",
    "url": "https://github.com/Zhuul/seamless-ai-bridge.git"
  },
  "name": "seamless-ai-bridge",
  "publisher": "zhuul",
  "displayName": "Seamless AI Bridge",
  "description": "An extensible chat participant for VS Code designed to route prompts to various AI models.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.108.1"
  },
  "activationEvents": [
    "*",
    "onChatParticipant:seamless-ai-bridge"
  ],
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "seamless-ai-bridge",
        "name": "bridge",
        "fullName": "Seamless AI Bridge",
        "description": "Bridge for connecting custom and self-hosted AI models.",
        "isSticky": true
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "seamlessAiBridge",
          "title": "Seamless AI Bridge",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "seamlessAiBridge": [
        {
          "id": "seamlessAiBridge.agentsView",
          "name": "Agents",
          "icon": "$(list-tree)"
        },
        {
          "id": "seamlessAiBridge.agentManagerView",
          "name": "Agent Manager",
          "icon": "$(settings-gear)",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "seamlessAiBridge.addAgent",
        "title": "Seamless AI Bridge: Add Agent"
      },
      {
        "command": "seamlessAiBridge.editAgent",
        "title": "Seamless AI Bridge: Edit Agent"
      },
      {
        "command": "seamlessAiBridge.removeAgent",
        "title": "Seamless AI Bridge: Remove Agent"
      },
      {
        "command": "seamlessAiBridge.resetAgentHistory",
        "title": "Seamless AI Bridge: Reset Agent History"
      },
      {
        "command": "seamlessAiBridge.refreshAgents",
        "title": "Seamless AI Bridge: Refresh Agents"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "seamlessAiBridge.addAgent",
          "when": "view == seamlessAiBridge.agentsView",
          "group": "navigation@1"
        },
        {
          "command": "seamlessAiBridge.refreshAgents",
          "when": "view == seamlessAiBridge.agentsView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "seamlessAiBridge.editAgent",
          "when": "view == seamlessAiBridge.agentsView",
          "group": "inline@1"
        },
        {
          "command": "seamlessAiBridge.resetAgentHistory",
          "when": "view == seamlessAiBridge.agentsView",
          "group": "inline@2"
        },
        {
          "command": "seamlessAiBridge.removeAgent",
          "when": "view == seamlessAiBridge.agentsView",
          "group": "inline@3"
        }
      ]
    },
    "configuration": {
      "title": "Seamless AI Bridge",
      "properties": {
        "seamlessAiBridge.path": {
          "type": "string",
          "markdownDescription": "Absolute path to an external bridge CLI. If empty, the extension uses the bundled `bridge-echo.js`. You can also set the environment variables `SEAMLESS_AI_BRIDGE_PATH` or `SEAMLESS_AI_CLI_PATH`.",
          "default": ""
        },
        "seamlessAiBridge.experimental.enableCrossParticipantChat": {
          "type": "boolean",
          "markdownDescription": "Experimental and unstable. When enabled, @bridge may attempt best-effort cross-participant command invocation before automatically falling back to the local bridge provider.",
          "default": false
        },
        "seamlessAiBridge.personas": {
          "type": "array",
          "scope": "resource",
          "markdownDescription": "Defines workspace-specific agents. User-level values for this setting are ignored by the extension at runtime and should be migrated.",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "alias"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "description": "Agent alias used in chat, for example `planner` for `@planner`."
              },
              "name": {
                "type": "string",
                "description": "Optional display name for the agent."
              },
              "enabled": {
                "type": "boolean",
                "description": "Enable or disable this agent.",
                "default": true
              },
              "provider": {
                "type": "string",
                "description": "Provider backing this agent.",
                "enum": [
                  "copilot",
                  "codex"
                ],
                "default": "copilot"
              },
              "model": {
                "type": "string",
                "description": "Model identifier used by the selected provider, for example `gpt-4.1`."
              },
              "capabilities": {
                "description": "Either `default` to use global defaults, or an explicit list of allowed capabilities such as `@workspace` and `@terminal`.",
                "oneOf": [
                  {
                    "type": "string",
                    "enum": [
                      "default"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ],
                "default": "default"
              },
              "historyPersistence": {
                "type": "boolean",
                "description": "When true, agent maintains multi-turn history. When false, requests are stateless.",
                "default": true
              },
              "modelSelector": {
                "description": "Deprecated V4 compatibility field. V5 uses `model`.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            }
          }
        },
        "seamlessAiBridge.defaultCapabilities": {
          "type": "array",
          "description": "Default capability set used by agents configured with `capabilities: default`.",
          "items": {
            "type": "string"
          },
          "default": [
            "@workspace"
          ]
        },
        "seamlessAiBridge.allowLegacyResetCommand": {
          "type": "boolean",
          "description": "Allow legacy text command `@bridge @alias /reset`. When false, users must reset via the Agent Manager UI.",
          "default": false
        },
        "seamlessAiBridge.developer.enableWipeCommand": {
          "type": "boolean",
          "description": "Enable the destructive `@bridge /wipe` developer command that clears user/workspace agent settings and cached histories.",
          "default": false
        },
        "seamlessAiBridge.debug.enabled": {
          "type": "boolean",
          "description": "Enable detailed debug logging to the Seamless AI Bridge output channel.",
          "default": false
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.2",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
